# Copy to .env.local for `vercel dev`, or set these in the Vercel project settings.
# Without them the app still works: lobbies use in-memory storage (local dev only)
# and connections use public STUN only (no TURN relay fallback).

# Upstash Redis (Vercel Marketplace sets one of these pairs automatically)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Cloudflare Realtime TURN (Dashboard -> Realtime -> TURN Server -> create key)
CF_TURN_KEY_ID=
CF_TURN_KEY_API_TOKEN=
